<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- 顶部状态栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#2D2D2D"
        android:padding="20dp"
        android:layout_marginBottom="16dp">

        <View
            android:id="@+id/status_indicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/status_circle"
            android:layout_marginEnd="14dp"
            android:layout_gravity="center_vertical"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADB: 检测中..."
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系统级 ADB 管理"
                android:textSize="15sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v-"
            android:textSize="15sp"
            android:textColor="#888888"
            android:layout_marginEnd="12dp"
            android:layout_gravity="center_vertical"/>

        <TextView
            android:id="@+id/tv_uid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UID: 1000"
            android:textSize="15sp"
            android:textColor="#4CAF50"/>
    </LinearLayout>

    <!-- 主区域：三栏水平分布 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左栏：USB ADB -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#2D2D2D"
            android:padding="24dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB ADB"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="通过 USB 调试连接"
                android:textSize="14sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="24dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="USB 调试"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"/>

                <Switch
                    android:id="@+id/sw_adb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:switchMinWidth="96dp"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:thumbTextPadding="10dp"
                    android:showText="true"
                    android:textOn="开"
                    android:textOff="关"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_usb_conn_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="主驾USB1: 检测中..."
                android:textSize="15sp"
                android:textColor="#888888"
                android:layout_marginTop="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <Button
                android:id="@+id/btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="检测更新"
                android:textSize="18sp"
                android:background="@drawable/btn_rounded"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/btn_exit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="退出"
                android:textSize="18sp"
                android:background="@drawable/btn_rounded"
                android:backgroundTint="#424242"
                android:textColor="#FFFFFF"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="抖音@大伦哥cdm"
                android:textSize="13sp"
                android:textColor="#555555"
                android:gravity="center"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- 中栏：无线 ADB + 无线调试 + 配对 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#2D2D2D"
            android:padding="24dp"
            android:layout_marginEnd="12dp"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="无线 ADB"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_wireless_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="状态: 未开启"
                android:textSize="15sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tv_ip_port"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP: 等待获取..."
                android:textSize="24sp"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:layout_marginTop="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TCP 5555 端口"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"/>

                <Switch
                    android:id="@+id/sw_wireless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:switchMinWidth="96dp"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:thumbTextPadding="10dp"
                    android:showText="true"
                    android:textOn="开"
                    android:textOff="关"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_wifi_clients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="无线客户端: 检测中..."
                android:textSize="15sp"
                android:textColor="#888888"
                android:layout_marginTop="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3D3D3D"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_wifi_debug_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="无线调试: 未开启"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"/>

                <Switch
                    android:id="@+id/sw_wifi_debug"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:switchMinWidth="96dp"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:thumbTextPadding="10dp"
                    android:showText="true"
                    android:textOn="开"
                    android:textOff="关"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3D3D3D"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="无线调试配对"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用于手机扫码/输入配对"
                android:textSize="14sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tv_pair_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="点击生成"
                android:textSize="36sp"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tv_pair_port"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="配对端口: -"
                android:textSize="16sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp"/>

            <Button
                android:id="@+id/btn_gen_pair"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="生成配对码"
                android:textSize="18sp"
                android:background="@drawable/btn_rounded"
                android:backgroundTint="#424242"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>

        <!-- 右栏：移动数据 + USB 供电 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#2D2D2D"
            android:padding="24dp"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="移动数据"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_mobile_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="状态: 检测中..."
                android:textSize="15sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="数据连接"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"/>

                <Switch
                    android:id="@+id/sw_mobile_data"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:switchMinWidth="96dp"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:thumbTextPadding="10dp"
                    android:showText="true"
                    android:textOn="开"
                    android:textOff="关"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3D3D3D"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB 供电"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="主驾USB1"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"/>

                <Switch
                    android:id="@+id/sw_usb2_power"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:switchMinWidth="96dp"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:thumbTextPadding="10dp"
                    android:showText="true"
                    android:textOn="开"
                    android:textOff="关"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="主驾USB2"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"/>

                <Switch
                    android:id="@+id/sw_usb31_power"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:switchMinWidth="96dp"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:thumbTextPadding="10dp"
                    android:showText="true"
                    android:textOn="开"
                    android:textOff="关"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="绿=开启 灰=关闭 禁用=不可用"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginTop="12dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
