<?xml version="1.0" encoding="utf-8"?>
<!--
    三栏横屏布局，按 1920x1080 / density 2.0（即 960x540dp）为基准排布：
    外层留白 16/10、栏内留白 16dp、间距 10dp，字号 24/18/15/13 起，
    保证 540dp 高度下三栏内容一屏放下（不再需要中/右栏滚动找内容）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- 顶部状态栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#2D2D2D"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginBottom="10dp">

        <View
            android:id="@+id/status_indicator"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/status_circle"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADB: 检测中..."
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系统级 ADB 管理"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="1dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tv_uid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UID: 1000"
                android:textSize="13sp"
                android:textColor="#4CAF50"/>

            <TextView
                android:id="@+id/tv_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v-"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="1dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 主区域：三栏水平分布 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左栏：USB 调试开关、无线 ADB 开关与状态 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginEnd="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB 调试"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="USB 调试"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"/>

                <Switch
                    android:id="@+id/sw_adb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:switchMinWidth="80dp"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:thumbTextPadding="8dp"
                    android:showText="true"
                    android:textOn="开"
                    android:textOff="关"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <Button
                android:id="@+id/btn_revoke_usb_auth"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="撤销 USB 调试授权"
                android:textSize="15sp"
                android:background="@drawable/btn_rounded"
                android:backgroundTint="#424242"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tv_usb_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="底层: 检测中..."
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="6dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3D3D3D"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="无线 ADB"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="无线 ADB（动态端口）"
                    android:textSize="15sp"
                    android:textColor="#FFFFFF"/>

                <Switch
                    android:id="@+id/sw_wireless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:switchMinWidth="80dp"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:thumbTextPadding="8dp"
                    android:showText="true"
                    android:textOn="开"
                    android:textOff="关"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3D3D3D"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tv_wireless_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="状态: 未开启"
                android:textSize="13sp"
                android:textColor="#888888"/>

            <TextView
                android:id="@+id/tv_ip_port"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP: 等待获取..."
                android:textSize="20sp"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tv_wifi_clients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="无线客户端: 检测中..."
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- 中栏：配对设备、配对端口、二维码（内容超屏时可上下滑动） -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:layout_marginStart="10dp"
            android:fillViewport="true"
            android:scrollbarStyle="outsideOverlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2D2D2D"
                android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="配对设备"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用手机扫码，或输入配对码完成配对"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp"/>

            <ImageView
                android:id="@+id/iv_pair_qr"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:background="#FFFFFF"
                android:contentDescription="配对二维码"/>

            <TextView
                android:id="@+id/tv_pair_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="点击生成"
                android:textSize="26sp"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/tv_pair_port"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="配对端口: -"
                android:textSize="14sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp"/>

            <Button
                android:id="@+id/btn_pair_qr"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="使用二维码配对设备"
                android:textSize="15sp"
                android:background="@drawable/btn_rounded"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"/>

            <Button
                android:id="@+id/btn_gen_pair"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="使用配对码配对设备"
                android:textSize="15sp"
                android:background="@drawable/btn_rounded"
                android:backgroundTint="#424242"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3D3D3D"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已配对的设备"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/ll_paired_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tv_paired_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无已配对的设备"
                android:textSize="13sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp"/>
            </LinearLayout>
        </ScrollView>

        <!-- 右栏：系统（检测更新 / 退出）与作者 -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:fillViewport="true"
            android:scrollbarStyle="outsideOverlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2D2D2D"
                android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系统"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="应用与维护"
                android:textSize="12sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp"/>

            <Button
                android:id="@+id/btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="检测更新"
                android:textSize="15sp"
                android:background="@drawable/btn_rounded"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:layout_marginTop="10dp"/>

            <Button
                android:id="@+id/btn_exit"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="退出"
                android:textSize="15sp"
                android:background="@drawable/btn_rounded"
                android:backgroundTint="#424242"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="抖音@大伦哥cdm"
                android:textSize="12sp"
                android:textColor="#555555"
                android:gravity="center"
                android:layout_marginTop="6dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
