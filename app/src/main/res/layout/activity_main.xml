<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A1A"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="16dp"
    android:paddingBottom="16dp">

    <!-- 顶部状态栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#2D2D2D"
        android:padding="20dp"
        android:layout_marginBottom="16dp">

        <View
            android:id="@+id/status_indicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/status_circle"
            android:layout_marginEnd="14dp"
            android:layout_gravity="center_vertical"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ADB: 检测中..."
                android:textSize="28sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系统级 ADB 管理"
                android:textSize="15sp"
                android:textColor="#888888"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v-"
            android:textSize="15sp"
            android:textColor="#888888"
            android:layout_marginEnd="12dp"
            android:layout_gravity="center_vertical"/>

        <TextView
            android:id="@+id/tv_uid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="UID: 1000"
            android:textSize="15sp"
            android:textColor="#4CAF50"/>
    </LinearLayout>

    <!-- 主区域：三栏水平分布 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 左栏：USB 调试开关、无线 ADB 开关与状态 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="#2D2D2D"
            android:padding="24dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB 调试"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="USB 调试"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"/>

                <Switch
                    android:id="@+id/sw_adb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:switchMinWidth="96dp"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:thumbTextPadding="10dp"
                    android:showText="true"
                    android:textOn="开"
                    android:textOff="关"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3D3D3D"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="无线 ADB"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="无线 ADB（动态端口）"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"/>

                <Switch
                    android:id="@+id/sw_wireless"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:switchMinWidth="96dp"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:thumbTextPadding="10dp"
                    android:showText="true"
                    android:textOn="开"
                    android:textOff="关"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3D3D3D"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tv_wireless_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="状态: 未开启"
                android:textSize="15sp"
                android:textColor="#888888"/>

            <TextView
                android:id="@+id/tv_ip_port"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP: 等待获取..."
                android:textSize="24sp"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/tv_wifi_clients"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="无线客户端: 检测中..."
                android:textSize="15sp"
                android:textColor="#888888"
                android:layout_marginTop="12dp"/>
        </LinearLayout>

        <!-- 中栏：配对设备、配对端口、二维码（可上下滑动） -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="12dp"
            android:layout_marginStart="12dp"
            android:fillViewport="true"
            android:scrollbarStyle="outsideOverlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2D2D2D"
                android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="配对设备"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用手机扫码，或输入配对码完成配对"
                android:textSize="14sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp"/>

            <ImageView
                android:id="@+id/iv_pair_qr"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:visibility="gone"
                android:background="#FFFFFF"
                android:contentDescription="配对二维码"/>

            <TextView
                android:id="@+id/tv_pair_code"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="点击生成"
                android:textSize="32sp"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tv_pair_port"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="配对端口: -"
                android:textSize="16sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp"/>

            <Button
                android:id="@+id/btn_pair_qr"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="使用二维码配对设备"
                android:textSize="18sp"
                android:background="@drawable/btn_rounded"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp"/>

            <Button
                android:id="@+id/btn_gen_pair"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="使用配对码配对设备"
                android:textSize="18sp"
                android:background="@drawable/btn_rounded"
                android:backgroundTint="#424242"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3D3D3D"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已配对的设备"
                android:textSize="20sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <LinearLayout
                android:id="@+id/ll_paired_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/tv_paired_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无已配对的设备"
                android:textSize="14sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>
            </LinearLayout>
        </ScrollView>

        <!-- 右栏：USB供电，底部为检查更新、退出与作者 -->
        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:fillViewport="true"
            android:scrollbarStyle="outsideOverlay">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#2D2D2D"
                android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="USB 供电"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="主驾USB1"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"/>

                <Switch
                    android:id="@+id/sw_usb2_power"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:switchMinWidth="96dp"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:thumbTextPadding="10dp"
                    android:showText="true"
                    android:textOn="开"
                    android:textOff="关"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="主驾USB2"
                    android:textSize="18sp"
                    android:textColor="#FFFFFF"/>

                <Switch
                    android:id="@+id/sw_usb31_power"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:switchMinWidth="96dp"
                    android:track="@drawable/switch_track"
                    android:thumb="@drawable/switch_thumb"
                    android:thumbTextPadding="10dp"
                    android:showText="true"
                    android:textOn="开"
                    android:textOff="关"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#3D3D3D"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="系统"
                android:textSize="22sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="应用与维护"
                android:textSize="14sp"
                android:textColor="#888888"
                android:layout_marginTop="4dp"/>

            <Button
                android:id="@+id/btn_check_update"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="检测更新"
                android:textSize="18sp"
                android:background="@drawable/btn_rounded"
                android:backgroundTint="#1976D2"
                android:textColor="#FFFFFF"
                android:layout_marginTop="16dp"/>

            <Button
                android:id="@+id/btn_exit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="退出"
                android:textSize="18sp"
                android:background="@drawable/btn_rounded"
                android:backgroundTint="#424242"
                android:textColor="#FFFFFF"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="抖音@大伦哥cdm"
                android:textSize="13sp"
                android:textColor="#555555"
                android:gravity="center"
                android:layout_marginTop="6dp"/>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</LinearLayout>
